# Copier en .env (jamais commité). Les secrets restent ici, pas dans config.yaml.

# --- Connexion au dashboard : au moins un utilisateur, ou un jeton machine -----------------------
# Hachage : python -m network_monitor.app.auth hash
# Rôle obligatoire : viewer (lecture) < operator (prise en charge, verdicts, maintenance) < admin (seuils, arrêt, essais).
# Ancien format {"alice": "<hash>"} toujours accepté : administrateur.
NM_USERS={"alice": {"hash": "scrypt$16384$8$1$...$...", "role": "admin"}, "bob": {"hash": "scrypt$16384$8$1$...$...", "role": "operator"}}
# Clé de signature des sessions (sans elle, les sessions ne survivent pas à un redémarrage)
# python -c "import secrets; print(secrets.token_hex(32))"
NM_AUTH_SECRET=
# NM_API_TOKEN=            # jeton machine optionnel (scripts, supervision)
# NM_API_TOKEN_ROLE=admin  # rôle du jeton machine : viewer, operator ou admin (admin par défaut, comme avant les rôles)

# --- Notifications (voir config.example.yaml, section notifications) -----------------------------
# NM_TELEGRAM_TOKEN=       # bot ajouté au groupe
# NM_WEBHOOK_URL=
# NM_WEBHOOK_SECRET=
# NM_SMS_URL=http://192.168.1.50:8080   # téléphone Android (passerelle SMS)
# NM_SMS_USER=
# NM_SMS_PASSWORD=
# NM_ORANGE_CLIENT_ID=
# NM_ORANGE_CLIENT_SECRET=

# --- Supervision ---------------------------------------------------------------------------------
# NM_METRICS_TOKEN=        # si défini, GET /metrics exige « Authorization: Bearer <ce jeton> » (sinon ouvert)
# NM_HEARTBEAT_URL=        # URL de ping du service de signal de vie (secret ; heartbeat.enabled: true l'exige)

# --- Sources de données --------------------------------------------------------------------------
# NM_SOURCE_BEARER=        # jeton de l'API Prometheus (source.bearer_token_env)
