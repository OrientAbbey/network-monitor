# URL de base de l'API FastAPI (voir ../app/api.py). Copier ce fichier en
# .env et l'ajuster si l'API tourne ailleurs qu'en local sur le port 8000.
VITE_API_BASE_URL=http://127.0.0.1:8000

# La connexion (identifiant + mot de passe, NM_USERS côté serveur) se fait dans
# le panneau Configuration : le jeton de session reste en mémoire.
# VITE_API_TOKEN injecte au build le jeton machine (NM_API_TOKEN) à la place —
# visible de quiconque charge la page, donc réservé à une démo locale.
# VITE_API_TOKEN=change-me
